# Copy this file to .env and fill in real values before running
# `docker compose up`.

# --- Domains ---
# Caddy requests a Let's Encrypt cert for each and routes to the matching app.
CATAT_DOMAIN=catat.sknrendra.com
MINGLE_DOMAIN=mingle.sknrendra.com
CALCULATOR_DOMAIN=anggi.sknrendra.com

# --- Image tags ---
CATAT_TAG=0.2
MINGLE_TAG=0.1.0
CALCULATOR_TAG=0.1.0

# --- Catat: BetterAuth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Catat: MinIO (object storage for note attachments) ---
MINIO_ROOT_USER=catat
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-password
MINIO_BUCKET=catat-attachments

# --- Catat: Resend (email verification on sign up) ---
CATAT_RESEND_API_KEY=
CATAT_EMAIL_FROM=Catat <noreply@catat.sknrendra.com>

# --- Mingle ---
# Generate with: openssl rand -base64 32
MINGLE_SESSION_SECRET=
MINGLE_RESEND_API_KEY=
MINGLE_RESEND_FROM_EMAIL=mingle@sknrendra.com

CALCULATOR_SECRET_KEY=
CALCULATOR_ADMIN_PASSWORD=
CALCULATOR_COOKIE_SECURE=
